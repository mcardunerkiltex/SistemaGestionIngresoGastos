# Copiar como /opt/gastos/.env en el servidor y completar. No subir este archivo con valores reales.

# Dominio que apunta a la IP del servidor (registro A). Caddy saca el certificado HTTPS solo.
DOMAIN=gastos.tudominio.com

# Imagen que publica el workflow de GitHub (en minúsculas).
APP_IMAGE=ghcr.io/mcardunerkiltex/sistemagestioningresogastos:latest

# Generar cada una con: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# Opcional: login con Google.
GOOGLE_CLIENT_ID=
